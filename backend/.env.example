# Copy these settings into backend/.env. Use the account credentials and
# Device ID displayed by SMS Gateway for Android on your phone.
SMSGATE_SEND_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_DEVICE_ID=

# Supported placeholders: {traveler_name}, {zone_name}, {zone_type}
SMSGATE_GEOFENCE_TEMPLATE=Travel Nexus: {traveler_name}, you entered the {zone_type} geofence "{zone_name}".

# Set both values in the Django hosting service after deploying face_service/Dockerfile.
FACE_RECOGNITION_SERVICE_URL=https://your-face-service.onrender.com
FACE_SERVICE_API_KEY=
